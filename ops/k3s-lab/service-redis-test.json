{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "redis-test",
    "namespace": "k3s-lab"
  },
  "spec": {
    "selector": {
      "app": "redis-test"
    },
    "ports": [
      {
        "name": "redis",
        "port": 6379,
        "targetPort": 6379,
        "protocol": "TCP"
      }
    ],
    "clusterIP": "None"
  }
}
