{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "backend-test",
    "namespace": "k3s-lab"
  },
  "spec": {
    "progressDeadlineSeconds": 600,
    "replicas": 1,
    "revisionHistoryLimit": 10,
    "selector": {
      "matchLabels": {
        "app": "backend-test"
      }
    },
    "strategy": {
      "rollingUpdate": {
        "maxSurge": "25%",
        "maxUnavailable": "25%"
      },
      "type": "RollingUpdate"
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "backend-test"
        }
      },
      "spec": {
        "containers": [
          {
            "args": [
              "const pg = encodeURIComponent(process.env.PG_PASSWORD);\nconst redis = encodeURIComponent(process.env.REDIS_PASSWORD);\nprocess.env.DATABASE_URL = `postgresql://postgres:${pg}@pg-test:5432/gt_lms_normalized?schema=public`;\nprocess.env.REDIS_URL = `redis://:${redis}@redis-test:6379/0`;\nrequire(\"./backend/dist/main\");\n"
            ],
            "command": [
              "node",
              "-e"
            ],
            "env": [
              {
                "name": "PG_PASSWORD",
                "valueFrom": {
                  "secretKeyRef": {
                    "key": "password",
                    "name": "pg-test-auth"
                  }
                }
              },
              {
                "name": "REDIS_PASSWORD",
                "valueFrom": {
                  "secretKeyRef": {
                    "key": "REDIS_PASSWORD",
                    "name": "redis-test-auth"
                  }
                }
              },
              {
                "name": "MINIO_ACCESS_KEY",
                "valueFrom": {
                  "secretKeyRef": {
                    "key": "MINIO_ROOT_USER",
                    "name": "minio-test-auth"
                  }
                }
              },
              {
                "name": "MINIO_SECRET_KEY",
                "valueFrom": {
                  "secretKeyRef": {
                    "key": "MINIO_ROOT_PASSWORD",
                    "name": "minio-test-auth"
                  }
                }
              },
              {
                "name": "NODE_ENV",
                "value": "production"
              },
              {
                "name": "PORT",
                "value": "5000"
              },
              {
                "name": "MINIO_ENDPOINT",
                "value": "minio-test"
              },
              {
                "name": "MINIO_PORT",
                "value": "9000"
              },
              {
                "name": "MINIO_USE_SSL",
                "value": "false"
              },
              {
                "name": "MINIO_PUBLIC_BASE_URL",
                "value": "http://localhost:19000/lms-media"
              },
              {
                "name": "CORS_ORIGINS",
                "value": "http://localhost:13000"
              },
              {
                "name": "PUBLIC_APP_URL",
                "value": "http://localhost:13000"
              }
            ],
            "envFrom": [
              {
                "secretRef": {
                  "name": "backend-test-auth"
                }
              }
            ],
            "image": "gt-lms-backend:lab-20260926-fix",
            "imagePullPolicy": "Never",
            "livenessProbe": {
              "failureThreshold": 3,
              "httpGet": {
                "path": "/api/health/live",
                "port": 5000,
                "scheme": "HTTP"
              },
              "periodSeconds": 30,
              "successThreshold": 1,
              "timeoutSeconds": 1
            },
            "name": "backend",
            "ports": [
              {
                "containerPort": 5000,
                "protocol": "TCP"
              }
            ],
            "readinessProbe": {
              "failureThreshold": 3,
              "httpGet": {
                "path": "/api/health/ready",
                "port": 5000,
                "scheme": "HTTP"
              },
              "periodSeconds": 10,
              "successThreshold": 1,
              "timeoutSeconds": 5
            },
            "resources": {
              "limits": {
                "memory": "768Mi"
              },
              "requests": {
                "cpu": "150m",
                "memory": "256Mi"
              }
            },
            "startupProbe": {
              "failureThreshold": 24,
              "httpGet": {
                "path": "/api/health/live",
                "port": 5000,
                "scheme": "HTTP"
              },
              "periodSeconds": 5,
              "successThreshold": 1,
              "timeoutSeconds": 1
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File"
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "restartPolicy": "Always",
        "schedulerName": "default-scheduler",
        "securityContext": {},
        "terminationGracePeriodSeconds": 30
      }
    }
  }
}
