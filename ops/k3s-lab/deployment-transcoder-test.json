{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "transcoder-test",
    "namespace": "k3s-lab"
  },
  "spec": {
    "progressDeadlineSeconds": 600,
    "replicas": 1,
    "revisionHistoryLimit": 10,
    "selector": {
      "matchLabels": {
        "app": "transcoder-test"
      }
    },
    "strategy": {
      "rollingUpdate": {
        "maxSurge": "25%",
        "maxUnavailable": "25%"
      },
      "type": "RollingUpdate"
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "transcoder-test"
        }
      },
      "spec": {
        "containers": [
          {
            "args": [
              "const password = encodeURIComponent(process.env.REDIS_PASSWORD);\nprocess.env.REDIS_URL = `redis://:${password}@redis-test:6379/0`;\nrequire(\"./workers/transcoder/dist/worker.js\");\n"
            ],
            "command": [
              "node",
              "-e"
            ],
            "env": [
              {
                "name": "REDIS_PASSWORD",
                "valueFrom": {
                  "secretKeyRef": {
                    "key": "REDIS_PASSWORD",
                    "name": "redis-test-auth"
                  }
                }
              },
              {
                "name": "MINIO_ACCESS_KEY",
                "valueFrom": {
                  "secretKeyRef": {
                    "key": "MINIO_ROOT_USER",
                    "name": "minio-test-auth"
                  }
                }
              },
              {
                "name": "MINIO_SECRET_KEY",
                "valueFrom": {
                  "secretKeyRef": {
                    "key": "MINIO_ROOT_PASSWORD",
                    "name": "minio-test-auth"
                  }
                }
              },
              {
                "name": "TRANSCODER_SHARED_SECRET",
                "valueFrom": {
                  "secretKeyRef": {
                    "key": "TRANSCODER_SHARED_SECRET",
                    "name": "backend-test-auth"
                  }
                }
              },
              {
                "name": "MINIO_ENDPOINT",
                "value": "minio-test"
              },
              {
                "name": "MINIO_PORT",
                "value": "9000"
              },
              {
                "name": "MINIO_USE_SSL",
                "value": "false"
              },
              {
                "name": "BACKEND_CALLBACK_URL",
                "value": "http://backend-test:5000/api/videos/transcode-callback"
              },
              {
                "name": "NODE_ENV",
                "value": "production"
              }
            ],
            "image": "gt-lms-transcoder:lab-20260926",
            "imagePullPolicy": "Never",
            "name": "transcoder",
            "resources": {
              "limits": {
                "cpu": "1",
                "ephemeral-storage": "2Gi",
                "memory": "1Gi"
              },
              "requests": {
                "cpu": "100m",
                "memory": "128Mi"
              }
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File"
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "restartPolicy": "Always",
        "schedulerName": "default-scheduler",
        "securityContext": {},
        "terminationGracePeriodSeconds": 60
      }
    }
  }
}
