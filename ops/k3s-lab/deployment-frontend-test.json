{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "frontend-test",
    "namespace": "k3s-lab"
  },
  "spec": {
    "progressDeadlineSeconds": 600,
    "replicas": 1,
    "revisionHistoryLimit": 10,
    "selector": {
      "matchLabels": {
        "app": "frontend-test"
      }
    },
    "strategy": {
      "rollingUpdate": {
        "maxSurge": "25%",
        "maxUnavailable": "25%"
      },
      "type": "RollingUpdate"
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "frontend-test"
        }
      },
      "spec": {
        "containers": [
          {
            "env": [
              {
                "name": "NODE_ENV",
                "value": "production"
              },
              {
                "name": "PORT",
                "value": "3000"
              },
              {
                "name": "HOSTNAME",
                "value": "0.0.0.0"
              },
              {
                "name": "INTERNAL_API_URL",
                "value": "http://backend-test:5000/api"
              },
              {
                "name": "NEXT_PUBLIC_API_URL",
                "value": "http://localhost:15000/api"
              },
              {
                "name": "NEXT_PUBLIC_APP_URL",
                "value": "http://localhost:13000"
              }
            ],
            "image": "gt-lms-frontend:lab-20260926",
            "imagePullPolicy": "Never",
            "name": "frontend",
            "ports": [
              {
                "containerPort": 3000,
                "protocol": "TCP"
              }
            ],
            "readinessProbe": {
              "failureThreshold": 3,
              "httpGet": {
                "path": "/",
                "port": 3000,
                "scheme": "HTTP"
              },
              "periodSeconds": 10,
              "successThreshold": 1,
              "timeoutSeconds": 5
            },
            "resources": {
              "limits": {
                "memory": "768Mi"
              },
              "requests": {
                "cpu": "150m",
                "memory": "256Mi"
              }
            },
            "startupProbe": {
              "failureThreshold": 24,
              "httpGet": {
                "path": "/",
                "port": 3000,
                "scheme": "HTTP"
              },
              "periodSeconds": 5,
              "successThreshold": 1,
              "timeoutSeconds": 1
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File"
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "restartPolicy": "Always",
        "schedulerName": "default-scheduler",
        "securityContext": {},
        "terminationGracePeriodSeconds": 30
      }
    }
  }
}
